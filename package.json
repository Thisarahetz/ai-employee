{
  "name": "ai-employee",
  "version": "0.1.0",
  "private": true,
  "description": "AI Employee — reusable multi-tenant AI Employee platform, connectable to any business system.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --env-mode=loose",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rm -rf node_modules",
    "prisma:generate": "pnpm --filter @ai-employee/api exec prisma generate",
    "prisma:migrate": "pnpm --filter @ai-employee/api exec prisma migrate dev",
    "prisma:studio": "pnpm --filter @ai-employee/api exec prisma studio",
    "prisma:seed": "pnpm --filter @ai-employee/api exec prisma db seed",
    "db:wipe": "pnpm --filter @ai-employee/api exec prisma db push --force-reset",
    "db:clean": "pnpm --filter @ai-employee/api exec prisma db push --force-reset",
    "db:reset": "pnpm --filter @ai-employee/api exec prisma db push --force-reset && pnpm prisma:seed"
  },
  "dependencies": {
    "@prisma/client": "5.22.0"
  },
  "devDependencies": {
    "turbo": "^2.1.3",
    "typescript": "^5.6.3",
    "prettier": "^3.3.3",
    "prisma": "5.22.0"
  }
}
