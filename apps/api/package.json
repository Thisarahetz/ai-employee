{
  "name": "@ai-employee/api",
  "version": "0.1.0",
  "private": true,
  "description": "AI Employee — NestJS API (core infra, auth, tenancy, conversations, integrations glue).",
  "license": "UNLICENSED",
  "prisma": {
    "schema": "../../prisma/schema.prisma",
    "seed": "ts-node --transpile-only scripts/seed.ts"
  },
  "scripts": {
    "start": "nest start",
    "start:dev": "nest start --watch",
    "dev": "nest start --watch",
    "build": "nest build",
    "typecheck": "tsc --noEmit -p tsconfig.build.json",
    "promote-admin": "ts-node --transpile-only scripts/promote-admin.ts",
    "seed": "ts-node --transpile-only scripts/seed.ts",
    "test": "node --test --require ts-node/register/transpile-only test/*.test.ts",
    "test:integration": "node --test --test-concurrency=1 --require ts-node/register/transpile-only test/integration/*.test.ts",
    "worker": "AI_WORKFORCE_WORKER=true node dist/main.js",
    "test:live": "node --test --require ts-node/register/transpile-only test/live/*.test.ts"
  },
  "dependencies": {
    "@ai-employee/ai-core": "workspace:*",
    "@ai-employee/channel-sdk": "workspace:*",
    "@ai-employee/shared": "workspace:*",
    "@ai-employee/types": "workspace:*",
    "@anthropic-ai/sdk": "^0.27.3",
    "@aws-sdk/client-s3": "^3.658.1",
    "@nestjs/bullmq": "^10.2.1",
    "@nestjs/common": "^10.4.4",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.4",
    "@nestjs/event-emitter": "^2.1.1",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.4",
    "@nestjs/swagger": "^7.4.2",
    "@nestjs/throttler": "^6.2.1",
    "@prisma/client": "^5.20.0",
    "ai-employee-sdk": "workspace:*",
    "axios": "^1.7.7",
    "bcrypt": "^5.1.1",
    "bullmq": "^5.13.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cron-parser": "4.9.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "mammoth": "1.8.0",
    "multer": "^1.4.5-lts.1",
    "openai": "^4.67.3",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pdf-parse": "1.1.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.5",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.4",
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.16.5",
    "@types/passport-jwt": "^4.0.1",
    "@types/pdf-parse": "1.1.4",
    "@types/uuid": "^10.0.0",
    "prisma": "5.22.0",
    "source-map-support": "^0.5.21",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.6.3"
  }
}
