# ── General ───────────────────────────────────────────────
NODE_ENV=development

# ── API (apps/api) ────────────────────────────────────────
API_PORT=3001
API_URL=http://localhost:3001
WEB_URL=http://localhost:3000
# Comma-separated allow-list, or `*` to reflect any origin (needed for the
# embeddable website-chat widget to call the API from customer domains).
CORS_ORIGINS=*

# ── Database ──────────────────────────────────────────────
POSTGRES_USER=ai_employee
POSTGRES_PASSWORD=ai_employee_dev
POSTGRES_DB=ai_employee
POSTGRES_PORT=5432
DATABASE_URL=postgresql://ai_employee:ai_employee_dev@localhost:5432/ai_employee?schema=public

# ── Redis / BullMQ ────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ── Auth ──────────────────────────────────────────────────
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d

# ── Credential / secrets encryption (integration_credentials, channel_credentials) ──
CREDENTIALS_ENCRYPTION_KEY=change-me-32-byte-base64-key

# ── Webhook signing ───────────────────────────────────────
WEBHOOK_SIGNING_SECRET=change-me-webhook-secret

# ── AI Providers (both implemented; picked per tenant/agent via ai_configurations) ──
OPENAI_API_KEY=
OPENAI_ORG_ID=
ANTHROPIC_API_KEY=

# ── Storage (S3-compatible) ───────────────────────────────
STORAGE_DRIVER=s3
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=ai-employee-dev
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# ── n8n ────────────────────────────────────────────────────
N8N_PORT=5678
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_WEBHOOK_URL=http://localhost:5678/
N8N_API_URL=http://localhost:5678/api/v1
N8N_API_KEY=
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change-me-n8n-password
N8N_ENCRYPTION_KEY=change-me-n8n-encryption-key
# Values the example workflows in n8n/workflows/ read via `{{ $env.* }}`.
# (docker-compose also sets N8N_BLOCK_ENV_ACCESS_IN_NODE=false so $env works —
# n8n 2.x blocks it by default.) Leave SLACK_WEBHOOK_URL blank to disable that step.
# Your real CRM's REST endpoint (leave empty if you have none — there is no mock CRM).
CRM_BASE_URL=
SLACK_WEBHOOK_URL=http://host.docker.internal:3001/api/v1/notifications/slack
# Where /notifications/slack actually posts (a Slack incoming webhook). Empty = Slack disabled.
SLACK_INCOMING_WEBHOOK_URL=
GLOWDESK_API_URL=http://host.docker.internal:3141
WHATSAPP_API_URL=http://host.docker.internal:3001/api/v1/channels/send
EMAIL_API_URL=http://host.docker.internal:3001/api/v1/notifications/email

# ── Channels ──────────────────────────────────────────────
# WhatsApp provider: "waha" (WhatsApp HTTP API, https://waha.devlike.pro/) or "meta_cloud_api"
WHATSAPP_PROVIDER=waha
WAHA_API_URL=http://localhost:3200
WAHA_API_KEY=
WAHA_SESSION=default
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=change-me-verify-token

# Email provider: "resend" (https://resend.com) or "smtp"
EMAIL_PROVIDER=resend
RESEND_API_KEY=
RESEND_FROM="AI Employee <onboarding@resend.dev>"
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
EMAIL_FROM=ai-employee@example.com

# ── Web (apps/web) ────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001

GEMINI_API_KEY=

# ── Production safety (see docs/production-and-integration-guide.md) ──────
# NODE_ENV=production makes startup reject missing/placeholder secrets.
NODE_ENV=development
# Shared secret n8n sends as `x-service-token` to /channels/send and /notifications/*.
# Generate: openssl rand -hex 32
INTERNAL_SERVICE_TOKEN=
# Webhook signing (required in production)
WHATSAPP_APP_SECRET=
WAHA_WEBHOOK_HMAC_KEY=
# Number of reverse-proxy hops in front of the API (e.g. 1 behind nginx), for real client IPs.
TRUST_PROXY=
RATE_LIMIT_PER_MINUTE=120
# LOG_FORMAT=json for log aggregators
LOG_FORMAT=
CORS_ORIGINS=

# ── AI provider defaults (tenants can override per agent) ───────────────
# OPENAI | ANTHROPIC | GEMINI
AI_DEFAULT_PROVIDER=GEMINI
AI_DEFAULT_MODEL=gemini-2.5-flash
# false = every business must add its own provider key (Settings → AI Configuration)
AI_ALLOW_PLATFORM_KEYS=true
# Integrations calling private/internal addresses: allowed outside production,
# blocked in production unless true (e.g. an on-prem system over VPN).
INTEGRATION_ALLOW_PRIVATE_NETWORK=
# Where uploaded knowledge-base files are stored when STORAGE_DRIVER is not s3.
LOCAL_STORAGE_DIR=

# ── AI workforce ─────────────────────────────────────────────────────────
# Set AI_WORKFORCE_WORKER=false on API-only instances and run separate workers.
AI_WORKFORCE_WORKER=true
AI_WORKFORCE_WORKER_CONCURRENCY=5
# Platform defaults for every tenant (owners can change them in Schedules & Limits).
# Use "unlimited" to remove a budget cap.
AI_DEFAULT_DAILY_BUDGET_USD=5
AI_DEFAULT_MONTHLY_BUDGET_USD=50
AI_DEFAULT_MAX_TASK_COST_USD=0.50
AI_DEFAULT_MAX_TASK_STEPS=8
AI_DEFAULT_MAX_CONCURRENT_TASKS=3
AI_DEFAULT_MAX_TASKS_PER_DAY=300
AI_DEFAULT_MAX_SCHEDULES=25
# Separate Redis key namespace per environment sharing one Redis.
BULL_PREFIX=bull

# ── First platform admin (pnpm prisma:seed) ──────────────────────────────
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=

# ── Tests ────────────────────────────────────────────────────────────────
# Integration tests use this database (name must end in _test). Defaults to
# ai_employee_test on the DATABASE_URL server.
TEST_DATABASE_URL=

# ── Rasa (intent classifier; "Rasa first, LLM only when it can't decide") ──
# On whenever RASA_BASE_URL is set; each business can switch it off in Settings → Customer replies.
# RASA_ENABLED=false turns it off for the whole platform (every message uses the LLM router as before).
# See docs/rasa-nlu.md. Rasa is internal; never expose its port publicly.
RASA_ENABLED=true
# Host dev (start.sh runs the API on the host): http://localhost:5005. docker-compose overrides this to http://rasa:5005 for the api container.
RASA_BASE_URL=http://localhost:5005
RASA_PORT=5005
RASA_AUTH_TOKEN=change-me-rasa-token
RASA_TIMEOUT_MS=1500
# Routing thresholds (tune with rasa/scripts/evaluate.py):
RASA_HIGH_CONFIDENCE=0.80
RASA_HIGH_RISK_CONFIDENCE=0.92
RASA_LOW_CONFIDENCE=0.50
RASA_MIN_MARGIN=0.15
RASA_TEMPLATE_MAX_WORDS=6
# Circuit breaker: skip Rasa for a while after repeated failures.
RASA_BREAKER_FAILURES=3
RASA_BREAKER_COOLDOWN_MS=30000
# Tag for the trained-model image (see rasa/README.md).
RASA_MODEL_VERSION=latest

# ── Voice calls (Twilio ConversationRelay) ──
# See docs/voice.md. Add a "Voice" channel in the dashboard and point your Twilio number's
# "A call comes in" webhook at its webhookUrl.
# Twilio auth token for signature checks. Prefer storing it per channel (Channels → credentials);
# this platform-wide value is only for a single self-hosted business.
TWILIO_AUTH_TOKEN=
# Public WebSocket URL Twilio connects to. Default: API_URL with ws(s):// + /voice/stream.
# VOICE_STREAM_URL=wss://api.example.com/voice/stream
# Twilio's own speech providers and voice (per-channel config overrides these).
VOICE_TTS_PROVIDER=Google
VOICE_STT_PROVIDER=Google
# VOICE_TTS_VOICE=
# Spoken languages for English and Sinhala conversations.
VOICE_LANG_EN=en-US
VOICE_LANG_SI=si-LK
# Say "this is taking longer" if no reply is ready after this long.
VOICE_REPLY_TIMEOUT_MS=15000
# Most calls open at once on this server.
VOICE_MAX_CALLS=100

