# ── General ───────────────────────────────────────────────
NODE_ENV=development

# ── API (apps/api) ────────────────────────────────────────
API_PORT=3001
API_URL=http://localhost:3001
WEB_URL=http://localhost:3000
# Comma-separated allow-list, or `*` to reflect any origin (needed for the
# embeddable website-chat widget to call the API from customer domains).
CORS_ORIGINS=*

# ── Database ──────────────────────────────────────────────
POSTGRES_USER=ai_employee
POSTGRES_PASSWORD=ai_employee_dev
POSTGRES_DB=ai_employee
POSTGRES_PORT=5432
DATABASE_URL=postgresql://ai_employee:ai_employee_dev@localhost:5432/ai_employee?schema=public

# ── Redis / BullMQ ────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ── Auth ──────────────────────────────────────────────────
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d

# ── Credential / secrets encryption (integration_credentials, channel_credentials) ──
CREDENTIALS_ENCRYPTION_KEY=change-me-32-byte-base64-key

# ── Webhook signing ───────────────────────────────────────
WEBHOOK_SIGNING_SECRET=change-me-webhook-secret

# ── AI Providers (both implemented; picked per tenant/agent via ai_configurations) ──
OPENAI_API_KEY=
OPENAI_ORG_ID=
ANTHROPIC_API_KEY=

# ── Storage (S3-compatible) ───────────────────────────────
STORAGE_DRIVER=s3
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=ai-employee-dev
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# ── n8n ────────────────────────────────────────────────────
N8N_PORT=5678
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_WEBHOOK_URL=http://localhost:5678/
N8N_API_URL=http://localhost:5678/api/v1
N8N_API_KEY=
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change-me-n8n-password
N8N_ENCRYPTION_KEY=change-me-n8n-encryption-key

# ── Channels ──────────────────────────────────────────────
WHATSAPP_PROVIDER=meta_cloud_api
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=change-me-verify-token
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
EMAIL_FROM=ai-employee@example.com

# ── Web (apps/web) ────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001

GEMINI_API_KEY=
