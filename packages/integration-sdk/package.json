{
  "name": "ai-employee-sdk",
  "version": "0.2.2",
  "private": false,
  "description": "Official TypeScript/Node.js SDK to connect external business systems (salons, clinics, hotels, e-commerce, CRM, ERP, etc.) to the AI Employee platform via the Integration API Contract.",
  "license": "MIT",
  "author": "AI Employee Platform Contributors",
  "homepage": "https://github.com/davinlabs/ai-employee#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/davinlabs/ai-employee.git",
    "directory": "packages/integration-sdk"
  },
  "bugs": {
    "url": "https://github.com/davinlabs/ai-employee/issues"
  },
  "keywords": [
    "ai",
    "ai-employee",
    "sdk",
    "integration",
    "express",
    "nestjs",
    "fastify",
    "api-contract",
    "automation",
    "agentic-ai",
    "tool-calling"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "typesVersions": {
    "*": {
      "express-adapter": [
        "dist/express-adapter.d.ts"
      ],
      "nestjs-adapter": [
        "dist/nestjs-adapter.d.ts"
      ],
      "validation": [
        "dist/validation.d.ts"
      ],
      "idempotency": [
        "dist/idempotency.d.ts"
      ],
      "registry": [
        "dist/registry.d.ts"
      ],
      "events": [
        "dist/events.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./express-adapter": {
      "types": "./dist/express-adapter.d.ts",
      "default": "./dist/express-adapter.js"
    },
    "./nestjs-adapter": {
      "types": "./dist/nestjs-adapter.d.ts",
      "default": "./dist/nestjs-adapter.js"
    },
    "./validation": {
      "types": "./dist/validation.d.ts",
      "default": "./dist/validation.js"
    },
    "./idempotency": {
      "types": "./dist/idempotency.d.ts",
      "default": "./dist/idempotency.js"
    },
    "./registry": {
      "types": "./dist/registry.d.ts",
      "default": "./dist/registry.js"
    },
    "./events": {
      "types": "./dist/events.d.ts",
      "default": "./dist/events.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "lint": "echo \"(no lint configured for integration-sdk)\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test test/sdk.test.js",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build && npm run test"
  },
  "peerDependencies": {
    "express": "^4.19.0 || ^5.0.0",
    "@nestjs/common": "^10.0.0",
    "@nestjs/core": "^10.0.0"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    },
    "@nestjs/common": {
      "optional": true
    },
    "@nestjs/core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@nestjs/common": "^10.4.4",
    "@nestjs/core": "^10.4.4",
    "@types/express": "^4.17.21",
    "@types/node": "^20.16.5",
    "express": "^4.19.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typescript": "^5.6.3"
  },
  "bin": {
    "ai-employee-sdk": "dist/cli.js"
  }
}
