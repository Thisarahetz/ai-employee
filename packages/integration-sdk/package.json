{
  "name": "@ai-employee/integration-sdk",
  "version": "0.1.0",
  "private": false,
  "description": "SDK for external business systems (salon, hotel, clinic, e-commerce, CRM, ...) to become AI-Employee-compatible: register actions once via registerAction() and auto-expose the GET /ai/actions + POST /ai/execute Integration API Contract via an Express or NestJS adapter.",
  "license": "UNLICENSED",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./express-adapter": {
      "types": "./dist/express-adapter.d.ts",
      "default": "./dist/express-adapter.js"
    },
    "./nestjs-adapter": {
      "types": "./dist/nestjs-adapter.d.ts",
      "default": "./dist/nestjs-adapter.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "lint": "echo \"(no lint configured for integration-sdk)\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "echo \"(no tests yet)\"",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "express": "^4.19.0",
    "@nestjs/common": "^10.0.0",
    "@nestjs/core": "^10.0.0"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    },
    "@nestjs/common": {
      "optional": true
    },
    "@nestjs/core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@nestjs/common": "^10.4.4",
    "@nestjs/core": "^10.4.4",
    "@types/express": "^4.17.21",
    "express": "^4.19.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typescript": "^5.6.3"
  }
}
