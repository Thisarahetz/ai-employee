{
  "name": "Appointment Lifecycle & Follow-up Sequence",
  "nodes": [
    {
      "id": "a1b2c3d4-0001-4000-8000-000000000001",
      "name": "Webhook - Appointment Created",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [200, 300],
      "webhookId": "appointment-lifecycle-sequence",
      "notes": "Receives the {tenantId, businessId, customerId, conversationId, eventType, data} envelope sent when an appointment is booked.",
      "parameters": {
        "path": "appointment-lifecycle-sequence",
        "httpMethod": "POST",
        "responseMode": "onReceived",
        "options": {}
      }
    },
    {
      "id": "a1b2c3d4-0001-4000-8000-000000000002",
      "name": "Extract Booking Details",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.3,
      "position": [420, 300],
      "notes": "Extracts client name, phone, email, service, time, and appointment ID.",
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            { "name": "tenantId", "value": "={{ $json.tenantId }}", "type": "string" },
            { "name": "conversationId", "value": "={{ $json.conversationId }}", "type": "string" },
            { "name": "customerId", "value": "={{ $json.customerId || $json.data.customerId }}", "type": "string" },
            { "name": "appointmentId", "value": "={{ $json.data.appointmentId }}", "type": "string" },
            { "name": "clientName", "value": "={{ $json.data.clientName }}", "type": "string" },
            { "name": "service", "value": "={{ $json.data.service }}", "type": "string" },
            { "name": "startTime", "value": "={{ $json.data.startTime }}", "type": "string" },
            { "name": "localTime", "value": "={{ $json.data.localTime }}", "type": "string" },
            { "name": "customerPhone", "value": "={{ $json.data.customerPhone }}", "type": "string" },
            { "name": "customerEmail", "value": "={{ $json.data.customerEmail }}", "type": "string" }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "a1b2c3d4-0001-4000-8000-000000000003",
      "name": "Send WhatsApp Confirmation",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [640, 300],
      "notes": "Sends instant WhatsApp booking confirmation to the customer.",
      "parameters": {
        "method": "POST",
        "url": "={{ $env.WHATSAPP_API_URL || 'http://host.docker.internal:3001/api/v1/channels/send' }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"recipient\": $json.customerPhone, \"content\": \"Hi \" + $json.clientName + \"! 👋 Your appointment for \" + $json.service + \" is confirmed for \" + $json.localTime + \". We look forward to seeing you at Acme Salon! Reply anytime if you need to make changes.\", \"tenantId\": $json.tenantId } }}",
        "options": {
          "timeout": 10000
        }
      }
    },
    {
      "id": "a1b2c3d4-0001-4000-8000-000000000004",
      "name": "Send Email Receipt",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [860, 300],
      "notes": "Dispatches an email receipt if customer provided an email address.",
      "parameters": {
        "method": "POST",
        "url": "={{ $env.EMAIL_API_URL || 'http://host.docker.internal:3001/api/v1/notifications/email' }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"to\": $json.customerEmail || 'customer@example.com', \"subject\": \"Appointment Confirmation: \" + $json.service, \"text\": \"Dear \" + $json.clientName + \",\\n\\nYour appointment ID is \" + $json.appointmentId + \" for \" + $json.service + \" on \" + $json.localTime + \".\\n\\nThank you for choosing Acme Salon!\" } }}",
        "options": {
          "timeout": 10000
        }
      }
    },
    {
      "id": "a1b2c3d4-0001-4000-8000-000000000005",
      "name": "Wait 24 Hours",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [1080, 300],
      "notes": "Waits 24 hours before sending the upcoming appointment reminder.",
      "parameters": {
        "amount": 24,
        "unit": "hours"
      }
    },
    {
      "id": "a1b2c3d4-0001-4000-8000-000000000006",
      "name": "Check Appointment Status",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1300, 300],
      "notes": "Queries GlowDesk integration to check if the appointment is still active.",
      "parameters": {
        "method": "POST",
        "url": "={{ $env.GLOWDESK_API_URL || 'http://host.docker.internal:3141' }}/ai/execute",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "Bearer ai-employee-test-token" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"action\": \"get_appointment_details\", \"data\": { \"appointmentId\": $('Extract Booking Details').item.json.appointmentId } } }}",
        "options": {
          "timeout": 10000
        }
      }
    },
    {
      "id": "a1b2c3d4-0001-4000-8000-000000000007",
      "name": "Is Still Confirmed?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1520, 300],
      "notes": "Verifies appointment status is not cancelled before sending reminder.",
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.data?.status || 'booked' }}",
              "operation": "notEqual",
              "value2": "cancelled"
            }
          ]
        }
      }
    },
    {
      "id": "a1b2c3d4-0001-4000-8000-000000000008",
      "name": "Send WhatsApp Reminder",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1760, 200],
      "notes": "Sends interactive 24h reminder with confirmation/reschedule options.",
      "parameters": {
        "method": "POST",
        "url": "={{ $env.WHATSAPP_API_URL || 'http://host.docker.internal:3001/api/v1/channels/send' }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"recipient\": $('Extract Booking Details').item.json.customerPhone, \"content\": \"Hi \" + $('Extract Booking Details').item.json.clientName + \" 👋 Just a reminder that you have your \" + $('Extract Booking Details').item.json.service + \" appointment tomorrow at \" + $('Extract Booking Details').item.json.localTime + \". Reply 1 to confirm or 2 to reschedule.\", \"tenantId\": $('Extract Booking Details').item.json.tenantId } }}",
        "options": {
          "timeout": 10000
        }
      }
    },
    {
      "id": "a1b2c3d4-0001-4000-8000-000000000009",
      "name": "Wait Until Post-Appointment",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [1980, 200],
      "notes": "Waits until appointment has concluded.",
      "parameters": {
        "amount": 24,
        "unit": "hours"
      }
    },
    {
      "id": "a1b2c3d4-0001-4000-8000-000000000010",
      "name": "Check Final Status",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2200, 200],
      "notes": "Checks if appointment was marked completed.",
      "parameters": {
        "method": "POST",
        "url": "={{ $env.GLOWDESK_API_URL || 'http://host.docker.internal:3141' }}/ai/execute",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "Bearer ai-employee-test-token" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"action\": \"get_appointment_details\", \"data\": { \"appointmentId\": $('Extract Booking Details').item.json.appointmentId } } }}",
        "options": {
          "timeout": 10000
        }
      }
    },
    {
      "id": "a1b2c3d4-0001-4000-8000-000000000011",
      "name": "Is Visit Completed?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [2420, 200],
      "notes": "Branches on completed vs cancelled.",
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.data?.status || 'completed' }}",
              "operation": "notEqual",
              "value2": "cancelled"
            }
          ]
        }
      }
    },
    {
      "id": "a1b2c3d4-0001-4000-8000-000000000012",
      "name": "Ask For Review (WhatsApp)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2660, 100],
      "notes": "Sends post-appointment feedback and review request.",
      "parameters": {
        "method": "POST",
        "url": "={{ $env.WHATSAPP_API_URL || 'http://host.docker.internal:3001/api/v1/channels/send' }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"recipient\": $('Extract Booking Details').item.json.customerPhone, \"content\": \"Hi \" + $('Extract Booking Details').item.json.clientName + \"! 🌟 Thank you for visiting Acme Salon today! How was your \" + $('Extract Booking Details').item.json.service + \"? We would love your feedback: ⭐⭐⭐⭐⭐\", \"tenantId\": $('Extract Booking Details').item.json.tenantId } }}",
        "options": {
          "timeout": 10000
        }
      }
    },
    {
      "id": "a1b2c3d4-0001-4000-8000-000000000013",
      "name": "Update CRM Notes",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2880, 100],
      "notes": "Logs completion and feedback survey sent in client CRM profile.",
      "parameters": {
        "method": "POST",
        "url": "={{ $env.GLOWDESK_API_URL || 'http://host.docker.internal:3141' }}/ai/execute",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "Bearer ai-employee-test-token" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"action\": \"update_client_crm\", \"data\": { \"clientId\": $('Check Final Status').item.json.data?.client?.id || $('Extract Booking Details').item.json.customerId, \"notes\": \"Completed appointment \" + $('Extract Booking Details').item.json.service + \". Post-visit review request sent.\" } } }}",
        "options": {
          "timeout": 10000
        }
      }
    },
    {
      "id": "a1b2c3d4-0001-4000-8000-000000000014",
      "name": "Stop Workflow (Cancelled)",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.3,
      "position": [1760, 440],
      "notes": "Logs cancellation and gracefully stops.",
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            { "name": "status", "value": "CANCELLED_STOPPED", "type": "string" },
            { "name": "appointmentId", "value": "={{ $('Extract Booking Details').item.json.appointmentId }}", "type": "string" }
          ]
        },
        "options": {}
      }
    }
  ],
  "connections": {
    "Webhook - Appointment Created": {
      "main": [
        [{ "node": "Extract Booking Details", "type": "main", "index": 0 }]
      ]
    },
    "Extract Booking Details": {
      "main": [
        [{ "node": "Send WhatsApp Confirmation", "type": "main", "index": 0 }]
      ]
    },
    "Send WhatsApp Confirmation": {
      "main": [
        [{ "node": "Send Email Receipt", "type": "main", "index": 0 }]
      ]
    },
    "Send Email Receipt": {
      "main": [
        [{ "node": "Wait 24 Hours", "type": "main", "index": 0 }]
      ]
    },
    "Wait 24 Hours": {
      "main": [
        [{ "node": "Check Appointment Status", "type": "main", "index": 0 }]
      ]
    },
    "Check Appointment Status": {
      "main": [
        [{ "node": "Is Still Confirmed?", "type": "main", "index": 0 }]
      ]
    },
    "Is Still Confirmed?": {
      "main": [
        [{ "node": "Send WhatsApp Reminder", "type": "main", "index": 0 }],
        [{ "node": "Stop Workflow (Cancelled)", "type": "main", "index": 0 }]
      ]
    },
    "Send WhatsApp Reminder": {
      "main": [
        [{ "node": "Wait Until Post-Appointment", "type": "main", "index": 0 }]
      ]
    },
    "Wait Until Post-Appointment": {
      "main": [
        [{ "node": "Check Final Status", "type": "main", "index": 0 }]
      ]
    },
    "Check Final Status": {
      "main": [
        [{ "node": "Is Visit Completed?", "type": "main", "index": 0 }]
      ]
    },
    "Is Visit Completed?": {
      "main": [
        [{ "node": "Ask For Review (WhatsApp)", "type": "main", "index": 0 }],
        [{ "node": "Stop Workflow (Cancelled)", "type": "main", "index": 0 }]
      ]
    },
    "Ask For Review (WhatsApp)": {
      "main": [
        [{ "node": "Update CRM Notes", "type": "main", "index": 0 }]
      ]
    }
  }
}
