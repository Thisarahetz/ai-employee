// AI Employee — multi-tenant platform schema.
// Every tenant-scoped model carries `tenantId` + an index; the API layer's
// TenantContext/Prisma extension enforces it on every query (see apps/api TenantModule).

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgvector(map: "vector")]
}

// ─────────────────────────────────────────────────────────────────────────
// Tenancy
// ─────────────────────────────────────────────────────────────────────────

enum TenantStatus {
  ACTIVE
  SUSPENDED
  TRIAL
}

model Tenant {
  id                    String       @id @default(cuid())
  name                  String
  slug                  String       @unique
  status                TenantStatus @default(TRIAL)
  plan                  String       @default("free")
  /// Language for customer replies when the customer's language is unknown,
  /// and for every reply when matchCustomerLanguage is false: "en" | "si".
  defaultLanguage       String       @default("en")
  /// Reply in the language the customer writes in (English, Sinhala, Singlish).
  matchCustomerLanguage Boolean      @default(true)
  /// How customer replies are produced. The plan can restrict this (PlanSettings).
  replyMode             ReplyMode    @default(HYBRID)
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  businesses            Business[]
  memberships           TenantMembership[]
  customers             Customer[]
  conversations         Conversation[]
  messages              Message[]
  conversationSummaries ConversationSummary[]
  knowledgeBases        KnowledgeBase[]
  documents             Document[]
  documentChunks        DocumentChunk[]
  integrations          Integration[]
  integrationActions    IntegrationAction[]
  channels              Channel[]
  aiAgents              AiAgent[]
  aiConfigurations      AiConfiguration[]
  aiUsageLogs           AiUsageLog[]
  workflows             Workflow[]
  workflowExecutions    WorkflowExecution[]
  humanHandoffs         HumanHandoff[]
  notifications         Notification[]
  events                Event[]
  auditLogs             AuditLog[]
  aiEmployees           AiEmployee[]
  aiEmployeeApprovals   AiEmployeeApproval[]
  aiEmployeeActivities  AiEmployeeActivity[]
  aiTasks               AiTask[]
  aiTaskSchedules       AiTaskSchedule[]
  aiSettings            TenantAiSettings?
  industryTemplates     IndustryTemplate[]
  automationRules       AiAutomationRule[]
  aiProviderKeys        TenantAiProviderKey[]
  ownerCommandThreads   OwnerCommandThread[]
  dynamicSagas          DynamicSaga[]
  synthesizedInvariants SynthesizedInvariant[]
  savedAnswers          SavedAnswer[]

  @@map("tenants")
}

/// A business unit under a tenant (usually one, occasionally several
/// locations/brands). Carried alongside tenant_id in n8n workflow payloads.
enum BusinessType {
  SALON
  HOTEL
  CLINIC
  ECOMMERCE
  CRM
  VEHICLE_SERVICE
  ERP
  CUSTOM
}

model Business {
  id                  String       @id @default(cuid())
  tenantId            String
  tenant              Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name                String
  type                BusinessType @default(CUSTOM)
  timezone            String       @default("UTC")
  settings            Json         @default("{}")
  /// Industry template this business was set up from (IndustryTemplate.key).
  industryTemplateKey String?
  /// Owner-editable business profile fed to every AI employee:
  /// { description, departments[], services, hours, brandVoice, goals[], policies }
  profile             Json         @default("{}")
  /// Set when this Location was mirrored from an external system's `GET /ai/knowledge`
  /// locations feed. `integrationId` is nulled (not cascaded) if that integration is
  /// removed; `externalId` is the source system's stable id, used to upsert on re-sync.
  integrationId       String?
  integration         Integration? @relation("IntegrationSyncedLocations", fields: [integrationId], references: [id], onDelete: SetNull)
  externalId          String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  integrations  Integration[]  @relation("BusinessIntegrations")
  channels      Channel[]
  conversations Conversation[]
  workflows     Workflow[]

  @@unique([integrationId, externalId])
  @@index([tenantId])
  @@index([integrationId])
  @@map("businesses")
}

// ─────────────────────────────────────────────────────────────────────────
// Users, tenant membership, RBAC
//
// User is a global identity (one row per person, one globally-unique email) —
// NOT tenant-scoped. A person's relationship to any given tenant (their role,
// membership status) lives in TenantMembership, so one person can belong to
// multiple tenants with different roles in each (see docs/architecture.md's
// "Platform Administration & Tenant Management" section). Platform-level
// access (platformRole) is separate again — unrelated to any tenant role.
// ─────────────────────────────────────────────────────────────────────────

enum UserStatus {
  ACTIVE
  INVITED
  DISABLED
}

/// Platform-level access, unrelated to any tenant. Deliberately just one real
/// tier for the MVP (see PlatformAdminGuard) — PLATFORM_ADMIN/SUPPORT_ADMIN
/// are natural future additions that don't require a schema change.
enum PlatformRole {
  NONE
  SUPER_ADMIN
}

model User {
  id               String       @id @default(cuid())
  email            String       @unique
  passwordHash     String
  firstName        String
  lastName         String
  phone            String?
  status           UserStatus   @default(ACTIVE)
  refreshTokenHash String?
  lastLoginAt      DateTime?
  platformRole     PlatformRole @default(NONE)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  memberships           TenantMembership[]
  assignedConversations Conversation[]     @relation("AssignedAgent")
  assignedHandoffs      HumanHandoff[]     @relation("AssignedAgent")
  notifications         Notification[]
  auditLogs             AuditLog[]
  platformAuditLogs     PlatformAuditLog[] @relation("PlatformAuditActor")

  @@map("users")
}

/// Fixed roles for the MVP — see docs/architecture.md for the full hierarchy
/// and permission rationale. Kept as an enum (not a customizable Role table)
/// deliberately, to avoid over-engineering RBAC before it's needed.
enum TenantRole {
  OWNER
  ADMIN
  MANAGER
  EMPLOYEE
}

enum MembershipStatus {
  ACTIVE
  INVITED
  DISABLED
}

/// The tenant_users join table — a User's role and status within one Tenant.
model TenantMembership {
  id           String           @id @default(cuid())
  tenantId     String
  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId       String
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         TenantRole
  status       MembershipStatus @default(ACTIVE)
  jobTitle     String?
  businessRole String?
  accessLevel  String           @default("STANDARD")
  permissions  String[]         @default([])
  allLocations Boolean          @default(true)
  locationIds  String[]         @default([])
  invitedBy    String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@unique([tenantId, userId])
  @@index([tenantId])
  @@index([userId])
  @@map("tenant_users")
}

// ─────────────────────────────────────────────────────────────────────────
// Customers (the tenant's end customers, i.e. who messages in)
// ─────────────────────────────────────────────────────────────────────────

model Customer {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// ID of this customer in the connected external business system, if known.
  externalId String?
  name       String?
  email      String?
  phone      String?
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  conversations Conversation[]

  @@index([tenantId])
  @@index([tenantId, externalId])
  @@map("customers")
}

// ─────────────────────────────────────────────────────────────────────────
// Conversations & messages
// ─────────────────────────────────────────────────────────────────────────

enum ConversationStatus {
  OPEN
  AI_HANDLING
  HUMAN_HANDLING
  CLOSED
}

enum AgentType {
  ROUTER
  SUPPORT
  KNOWLEDGE
  ACTION
  HUMAN
}

model Conversation {
  id             String             @id @default(cuid())
  tenantId       String
  tenant         Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  businessId     String?
  business       Business?          @relation(fields: [businessId], references: [id])
  customerId     String
  customer       Customer           @relation(fields: [customerId], references: [id], onDelete: Cascade)
  channelId      String
  channel        Channel            @relation(fields: [channelId], references: [id])
  status         ConversationStatus @default(OPEN)
  currentAgent   AgentType?
  /// Language the customer writes in, detected from their messages:
  /// "en" | "si" (Sinhala script) | "si-Latn" (Singlish). Null until known.
  language       String?
  assignedUserId String?
  assignedUser   User?              @relation("AssignedAgent", fields: [assignedUserId], references: [id])
  lastMessageAt  DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  messages      Message[]
  summaries     ConversationSummary[]
  humanHandoffs HumanHandoff[]
  aiUsageLogs   AiUsageLog[]
  dynamicSagas  DynamicSaga[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, customerId])
  @@index([tenantId, language])
  @@map("conversations")
}

enum MessageSender {
  CUSTOMER
  AI
  HUMAN_AGENT
  SYSTEM
}

enum MessageContentType {
  TEXT
  IMAGE
  FILE
  AUDIO
  LOCATION
  SYSTEM_EVENT
}

model Message {
  id             String             @id @default(cuid())
  tenantId       String
  tenant         Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversationId String
  conversation   Conversation       @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         MessageSender
  agentType      AgentType?
  content        String
  contentType    MessageContentType @default(TEXT)
  metadata       Json               @default("{}")
  createdAt      DateTime           @default(now())

  aiUsageLog AiUsageLog?

  @@index([tenantId])
  @@index([tenantId, conversationId, createdAt])
  @@map("messages")
}

/// Rolling summary of older messages so the full history is never resent to the AI.
model ConversationSummary {
  id             String       @id @default(cuid())
  tenantId       String
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  summary        String
  /// Messages up to (and including) this timestamp are covered by `summary`.
  coveredUntil   DateTime
  createdAt      DateTime     @default(now())

  @@index([tenantId])
  @@index([tenantId, conversationId, coveredUntil])
  @@map("conversation_summaries")
}

// ─────────────────────────────────────────────────────────────────────────
// Knowledge base / RAG
// ─────────────────────────────────────────────────────────────────────────

model KnowledgeBase {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  documents         Document[]
  syncedIntegration Integration[]

  @@index([tenantId])
  @@map("knowledge_bases")
}

enum DocumentSourceType {
  PDF
  DOCX
  TEXT
  FAQ
  URL
  /// Synced from an external system via an Integration's `GET /ai/knowledge` endpoint.
  INTEGRATION
}

enum DocumentStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

model Document {
  id              String             @id @default(cuid())
  tenantId        String
  tenant          Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  knowledgeBaseId String
  knowledgeBase   KnowledgeBase      @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)
  title           String
  sourceType      DocumentSourceType
  fileUrl         String?
  status          DocumentStatus     @default(PENDING)
  errorMessage    String?
  /// Set when sourceType is INTEGRATION: the Integration this document was synced from.
  integrationId   String?
  integration     Integration?       @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  /// Stable per-integration identifier for the source record, used to upsert on re-sync.
  externalId      String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  chunks DocumentChunk[]

  @@unique([integrationId, externalId])
  @@index([tenantId])
  @@index([tenantId, knowledgeBaseId])
  @@index([integrationId])
  @@map("documents")
}

model DocumentChunk {
  id              String                       @id @default(cuid())
  tenantId        String
  tenant          Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  documentId      String
  document        Document                     @relation(fields: [documentId], references: [id], onDelete: Cascade)
  knowledgeBaseId String
  content         String
  /// text-embedding-3-small / voyage dimensionality; adjust per provider if changed.
  embedding       Unsupported("vector(1536)")?
  chunkIndex      Int
  tokenCount      Int
  createdAt       DateTime                     @default(now())

  @@index([tenantId])
  @@index([tenantId, knowledgeBaseId])
  @@map("document_chunks")
}

// ─────────────────────────────────────────────────────────────────────────
// Integrations (generic Integration Layer — connects to any external system)
// ─────────────────────────────────────────────────────────────────────────

enum IntegrationType {
  STANDARD_API
  REST_API
  WEBHOOK
  N8N
}

enum IntegrationStatus {
  CONNECTED
  DISCONNECTED
  ERROR
}

model Integration {
  id                     String            @id @default(cuid())
  tenantId               String
  tenant                 Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  businessId             String?
  business               Business?         @relation("BusinessIntegrations", fields: [businessId], references: [id])
  name                   String
  type                   IntegrationType
  baseUrl                String?
  /// REST_API type: endpoint/header/auth/request-response mapping config.
  config                 Json              @default("{}")
  status                 IntegrationStatus @default(DISCONNECTED)
  /// Dedicated KnowledgeBase auto-created to hold this integration's `GET /ai/knowledge` sync output.
  knowledgeBaseId        String?
  knowledgeBase          KnowledgeBase?    @relation(fields: [knowledgeBaseId], references: [id], onDelete: SetNull)
  lastKnowledgeSyncAt    DateTime?
  /// Per-integration HMAC secret for inbound webhooks (AES-GCM encrypted).
  webhookSecretEncrypted String?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  credentials     IntegrationCredential[]
  actions         IntegrationAction[]
  syncedDocuments Document[]
  syncedLocations Business[]              @relation("IntegrationSyncedLocations")

  @@index([tenantId])
  @@index([knowledgeBaseId])
  @@map("integrations")
}

enum CredentialType {
  API_KEY
  OAUTH2
  BASIC_AUTH
  BEARER_TOKEN
}

model IntegrationCredential {
  id               String         @id @default(cuid())
  tenantId         String
  integrationId    String
  integration      Integration    @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  type             CredentialType
  /// AES-encrypted JSON payload (see CREDENTIALS_ENCRYPTION_KEY). Never store plaintext.
  encryptedPayload String
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([tenantId])
  @@map("integration_credentials")
}

/// Actions discovered from `GET /ai/actions` on the external system, or
/// registered directly via the Integration SDK's `registerAction()`.
model IntegrationAction {
  id               String      @id @default(cuid())
  tenantId         String
  tenant           Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  integrationId    String
  integration      Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  name             String
  description      String
  /// JSON-schema-like parameter definition, matches the Integration API Contract.
  parameters       Json        @default("{}")
  isEnabled        Boolean     @default(true)
  lastDiscoveredAt DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@unique([integrationId, name])
  @@index([tenantId])
  @@map("integration_actions")
}

// ─────────────────────────────────────────────────────────────────────────
// Channels (WhatsApp, website chat, email, ...)
// ─────────────────────────────────────────────────────────────────────────

enum ChannelType {
  WHATSAPP
  WEBSITE_CHAT
  EMAIL
  FACEBOOK_MESSENGER
  INSTAGRAM
  TELEGRAM
  SMS
  VOICE
}

enum ChannelStatus {
  ACTIVE
  INACTIVE
}

model Channel {
  id         String        @id @default(cuid())
  tenantId   String
  tenant     Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  businessId String?
  business   Business?     @relation(fields: [businessId], references: [id])
  type       ChannelType
  name       String
  status     ChannelStatus @default(ACTIVE)
  config     Json          @default("{}")
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  credentials   ChannelCredential[]
  conversations Conversation[]

  @@index([tenantId])
  @@map("channels")
}

model ChannelCredential {
  id               String   @id @default(cuid())
  tenantId         String
  channelId        String
  channel          Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  /// AES-encrypted JSON payload (tokens, webhook secrets, SMTP creds, ...).
  encryptedPayload String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([tenantId])
  @@map("channel_credentials")
}

// ─────────────────────────────────────────────────────────────────────────
// AI agents & configuration
// ─────────────────────────────────────────────────────────────────────────

model AiAgent {
  id           String    @id @default(cuid())
  tenantId     String
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  type         AgentType
  name         String
  systemPrompt String    @default("")
  isEnabled    Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  configuration AiConfiguration?

  @@unique([tenantId, type])
  @@index([tenantId])
  @@map("ai_agents")
}

enum AiProviderName {
  OPENAI
  ANTHROPIC
  GEMINI
}

model AiConfiguration {
  id          String         @id @default(cuid())
  tenantId    String
  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  aiAgentId   String         @unique
  aiAgent     AiAgent        @relation(fields: [aiAgentId], references: [id], onDelete: Cascade)
  provider    AiProviderName
  model       String
  temperature Float          @default(0.3)
  maxTokens   Int            @default(1024)
  extraParams Json           @default("{}")
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([tenantId])
  @@map("ai_configurations")
}

/// Per-call token/cost tracking — the core observability signal for token optimization.
model AiUsageLog {
  id               String         @id @default(cuid())
  tenantId         String
  tenant           Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversationId   String?
  conversation     Conversation?  @relation(fields: [conversationId], references: [id])
  messageId        String?        @unique
  message          Message?       @relation(fields: [messageId], references: [id])
  agentType        AgentType
  provider         AiProviderName
  model            String
  inputTokens      Int
  outputTokens     Int
  estimatedCostUsd Decimal        @db.Decimal(10, 6)
  executionTimeMs  Int
  /// Set when the call was made while executing an AI workforce task.
  taskId           String?
  createdAt        DateTime       @default(now())

  @@index([tenantId])
  @@index([tenantId, agentType, createdAt])
  @@index([tenantId, createdAt])
  @@index([taskId])
  @@map("ai_usage_logs")
}

// ─────────────────────────────────────────────────────────────────────────
// AI Employees — Business Personas, Permissions, Approvals & Activities
// ─────────────────────────────────────────────────────────────────────────

model AiEmployee {
  id                   String   @id @default(cuid())
  tenantId             String
  tenant               Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name                 String
  role                 String
  department           String
  businessFunction     String
  description          String
  avatar               String?
  status               String   @default("ACTIVE") // ACTIVE, PAUSED, NEEDS_ATTENTION
  actionLevel          String   @default("AUTOMATIC") // AUTOMATIC, APPROVAL_REQUIRED, OWNER_ONLY
  scope                String   @default("ALL_BRANCHES") // ALL_BRANCHES, SELECTED_BRANCHES
  branchIds            String[] @default([])
  responsibilities     Json     @default("[]")
  assignedTasks        Json     @default("[]")
  permissions          Json     @default("{}")
  systemPrompt         String   @default("")
  /// Command-engine tool grants (see ai-workforce/workforce-tools.ts). Only
  /// authoritative once `toolAccessConfigured` is true; before that the
  /// role-safe default grant set applies.
  connectedTools       String[] @default([])
  toolAccessConfigured Boolean  @default(false)
  stats                Json     @default("{}")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  approvals       AiEmployeeApproval[]
  activities      AiEmployeeActivity[]
  tasks           AiTask[]
  schedules       AiTaskSchedule[]
  automationRules AiAutomationRule[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@map("ai_employees")
}

model AiEmployeeApproval {
  id               String     @id @default(cuid())
  tenantId         String
  tenant           Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employeeId       String
  employee         AiEmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  title            String
  description      String
  actionType       String
  actionPayload    Json       @default("{}")
  status           String     @default("PENDING") // PENDING, APPROVED, REJECTED
  requestedAt      DateTime   @default(now())
  reviewedAt       DateTime?
  reviewedByUserId String?
  reviewNotes      String?
  /// Set when the approval gates a command-engine tool call. `actionPayload`
  /// then holds `{ kind: "tool_call", tool, args }`, executed on approval.
  taskId           String?
  task             AiTask?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  executedAt       DateTime?
  executionResult  Json?

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([taskId])
  @@map("ai_employee_approvals")
}

model AiEmployeeActivity {
  id         String     @id @default(cuid())
  tenantId   String
  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employeeId String
  employee   AiEmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  action     String
  category   String     @default("CUSTOMER") // CUSTOMER, SALES, INVENTORY, FINANCE, OPERATIONS
  details    String
  status     String     @default("SUCCESS") // SUCCESS, PENDING_APPROVAL, REJECTED, FAILED
  branchId   String?
  createdAt  DateTime   @default(now())

  @@index([tenantId])
  @@index([tenantId, employeeId, createdAt])
  @@map("ai_employee_activities")
}

// ─────────────────────────────────────────────────────────────────────────
// AI Workforce — owner commands, tasks and execution steps
// ─────────────────────────────────────────────────────────────────────────

/// A unit of work assigned to an AI employee by the owner (directly, via a
/// chat command, or delegated by another AI employee).
model AiTask {
  id                  String              @id @default(cuid())
  tenantId            String
  tenant              Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employeeId          String?
  employee            AiEmployee?         @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  /// Group parent for commands sent to several employees at once.
  parentTaskId        String?
  parent              AiTask?             @relation("AiTaskGroup", fields: [parentTaskId], references: [id], onDelete: Cascade)
  children            AiTask[]            @relation("AiTaskGroup")
  /// Set when another AI employee delegated this task.
  delegatedFromTaskId String?
  /// Set for review tasks: the task whose result is being reviewed.
  reviewOfTaskId      String?
  threadId            String?
  thread              OwnerCommandThread? @relation(fields: [threadId], references: [id], onDelete: SetNull)
  kind                String              @default("TASK") // TASK, REVIEW, GROUP
  title               String
  description         String              @default("")
  goal                String?
  priority            String              @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  /// QUEUED, RUNNING, WAITING_APPROVAL, PAUSED, BLOCKED, COMPLETED, FAILED, CANCELLED
  status              String              @default("QUEUED")
  progress            Int                 @default(0)
  deadline            DateTime?
  /// Confidential results are never shown to other employees' context.
  confidential        Boolean             @default(false)
  /// Ids of earlier tasks whose results this task may use as context.
  contextTaskIds      String[]            @default([])
  result              String?
  error               String?
  createdByUserId     String?
  /// Set when a recurring schedule created this task.
  scheduleId          String?
  schedule            AiTaskSchedule?     @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  /// Set when an automation rule created this task.
  automationRuleId    String?
  automationRule      AiAutomationRule?   @relation(fields: [automationRuleId], references: [id], onDelete: SetNull)
  /// Event data that triggered the task — shown to the AI as untrusted data, never as instructions.
  triggerContext      Json?
  /// Execution attempts so far (automatic retries + owner retries).
  attempts            Int                 @default(0)
  maxAttempts         Int                 @default(3)
  /// When a retry is scheduled, the earliest time it will run.
  nextRunAt           DateTime?
  /// Refreshed by the worker while RUNNING; a stale heartbeat means the worker died.
  heartbeatAt         DateTime?
  inputTokens         Int                 @default(0)
  outputTokens        Int                 @default(0)
  costUsd             Decimal             @default(0) @db.Decimal(10, 6)
  startedAt           DateTime?
  completedAt         DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  steps     AiTaskStep[]
  approvals AiEmployeeApproval[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, employeeId, createdAt])
  @@index([parentTaskId])
  @@index([scheduleId, status])
  @@index([status, heartbeatAt])
  @@map("ai_tasks")
}

/// Execution log: one row per plan note, tool call, approval request, result or error.
/// Industry template: suggested AI employee roles, recurring schedules and
/// automation rules for a kind of business. `tenantId` null = platform
/// template (built-in or created by a platform admin); otherwise a business's
/// own customised template. `definition` is validated by
/// business-setup/template-definition.ts.
model IndustryTemplate {
  id              String       @id @default(cuid())
  tenantId        String?
  tenant          Tenant?      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  key             String
  name            String
  category        String       @default("General")
  icon            String       @default("Briefcase")
  description     String       @default("")
  businessType    BusinessType @default(CUSTOM)
  definition      Json
  isBuiltIn       Boolean      @default(false)
  isPublished     Boolean      @default(true)
  version         Int          @default(1)
  basedOnKey      String?
  createdByUserId String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([tenantId, key])
  @@index([isPublished])
  @@map("industry_templates")
}

/// "When <event> happens and <conditions> match, do <action>" — event-driven
/// work for AI employees. Bounded by a cooldown per dedupe key and a
/// per-rule hourly cap; events caused by AI tasks are ignored unless
/// `allowAiTriggered` is set, so rules can't feed each other forever.
model AiAutomationRule {
  id               String      @id @default(cuid())
  tenantId         String
  tenant           Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name             String
  description      String      @default("")
  enabled          Boolean     @default(true)
  triggerEvent     String
  /// [{ field: "status", op: "eq", value: "cancelled" }]
  conditions       Json        @default("[]")
  /// CREATE_TASK | NOTIFY_OWNER
  actionType       String      @default("CREATE_TASK")
  employeeId       String?
  employee         AiEmployee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  /// May contain {{field}} placeholders filled from the event.
  taskTitle        String
  taskDescription  String      @default("")
  priority         String      @default("MEDIUM")
  dedupeKey        String?
  cooldownSeconds  Int         @default(0)
  maxRunsPerHour   Int         @default(20)
  allowAiTriggered Boolean     @default(false)
  triggerCount     Int         @default(0)
  lastTriggeredAt  DateTime?
  lastError        String?
  templateKey      String?
  createdByUserId  String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  runs  AiAutomationRun[]
  tasks AiTask[]

  @@index([tenantId, triggerEvent, enabled])
  @@map("ai_automation_rules")
}

model AiAutomationRun {
  id          String           @id @default(cuid())
  tenantId    String
  ruleId      String
  rule        AiAutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  eventType   String
  dedupeValue String?
  /// TASK_CREATED | NOTIFIED | SKIPPED_COOLDOWN | SKIPPED_RATE_LIMIT | SKIPPED_LIMIT | FAILED
  status      String
  taskId      String?
  message     String           @default("")
  createdAt   DateTime         @default(now())

  @@index([ruleId, createdAt])
  @@index([ruleId, dedupeValue, createdAt])
  @@index([tenantId, createdAt])
  @@map("ai_automation_runs")
}

/// A business's own AI provider API key (bring-your-own-key), AES-GCM
/// encrypted. Never returned by the API — only `keyHint` (last 4 chars).
model TenantAiProviderKey {
  id              String         @id @default(cuid())
  tenantId        String
  tenant          Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  provider        AiProviderName
  encryptedKey    String
  keyHint         String
  createdByUserId String?
  lastUsedAt      DateTime?
  lastError       String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@unique([tenantId, provider])
  @@map("tenant_ai_provider_keys")
}

/// A recurring assignment: the scheduler creates an AiTask for the employee each
/// time the cron expression fires (evaluated in `timezone`).
model AiTaskSchedule {
  id                     String     @id @default(cuid())
  tenantId               String
  tenant                 Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employeeId             String
  employee               AiEmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  title                  String
  description            String     @default("")
  goal                   String?
  priority               String     @default("MEDIUM")
  /// Standard 5-field cron expression, e.g. "0 9 * * 1-5".
  cron                   String
  timezone               String     @default("UTC")
  enabled                Boolean    @default(true)
  /// SKIP: don't start a new run while the previous one is still active.
  /// QUEUE: always create the next run.
  overlapPolicy          String     @default("SKIP")
  nextRunAt              DateTime?
  lastRunAt              DateTime?
  lastTaskId             String?
  lastStatus             String?
  /// The schedule disables itself after this many failed runs in a row.
  consecutiveFailures    Int        @default(0)
  maxConsecutiveFailures Int        @default(3)
  createdByUserId        String?
  createdAt              DateTime   @default(now())
  updatedAt              DateTime   @updatedAt

  tasks AiTask[]

  @@index([tenantId])
  @@index([enabled, nextRunAt])
  @@index([employeeId])
  @@map("ai_task_schedules")
}

/// Per-tenant AI safety limits. A missing row means platform defaults apply
/// (see ai-workforce/usage-limits.ts).
model TenantAiSettings {
  tenantId           String   @id
  tenant             Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// Kill switch: when false no AI workforce task runs for this tenant.
  aiEnabled          Boolean  @default(true)
  monthlyBudgetUsd   Decimal? @db.Decimal(10, 2)
  dailyBudgetUsd     Decimal? @db.Decimal(10, 2)
  maxTaskCostUsd     Decimal? @db.Decimal(10, 4)
  maxTaskSteps       Int?
  maxConcurrentTasks Int?
  maxTasksPerDay     Int?
  maxSchedules       Int?
  updatedByUserId    String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("tenant_ai_settings")
}

model AiTaskStep {
  id        String   @id @default(cuid())
  tenantId  String
  taskId    String
  task      AiTask   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  seq       Int
  kind      String // NOTE, TOOL_CALL, APPROVAL_REQUESTED, APPROVAL_DECISION, RESULT, ERROR, CONTROL
  toolName  String?
  input     Json?
  output    Json?
  status    String   @default("SUCCESS") // SUCCESS, FAILED, PENDING, BLOCKED, REJECTED
  message   String   @default("")
  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([taskId, seq])
  @@map("ai_task_steps")
}

/// A conversation between an owner/admin and the AI workforce.
model OwnerCommandThread {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String
  title     String   @default("New conversation")
  /// Follow-up memory: { taskIds: string[], employeeIds: string[] } most recently discussed.
  focus     Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages OwnerCommandMessage[]
  tasks    AiTask[]

  @@index([tenantId, userId, updatedAt])
  @@map("owner_command_threads")
}

model OwnerCommandMessage {
  id         String             @id @default(cuid())
  tenantId   String
  threadId   String
  thread     OwnerCommandThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  role       String // OWNER, AI, SYSTEM
  userId     String?
  employeeId String?
  content    String
  /// { intent, taskIds, approvalIds, limitations }
  metadata   Json               @default("{}")
  createdAt  DateTime           @default(now())

  @@index([tenantId])
  @@index([threadId, createdAt])
  @@map("owner_command_messages")
}

// ─────────────────────────────────────────────────────────────────────────
// n8n workflows
// ─────────────────────────────────────────────────────────────────────────

model Workflow {
  id               String    @id @default(cuid())
  tenantId         String
  tenant           Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  businessId       String?
  business         Business? @relation(fields: [businessId], references: [id])
  name             String
  n8nWorkflowId    String
  /// Event type (see Event.type) that triggers this workflow, e.g. "human_handoff.requested".
  triggerEventType String
  isEnabled        Boolean   @default(true)
  description      String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  executions WorkflowExecution[]

  @@index([tenantId])
  @@map("workflows")
}

enum WorkflowExecutionStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
}

model WorkflowExecution {
  id             String                  @id @default(cuid())
  tenantId       String
  tenant         Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workflowId     String
  workflow       Workflow                @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  eventId        String?
  event          Event?                  @relation(fields: [eventId], references: [id])
  status         WorkflowExecutionStatus @default(PENDING)
  n8nExecutionId String?
  input          Json                    @default("{}")
  output         Json?
  errorMessage   String?
  startedAt      DateTime                @default(now())
  finishedAt     DateTime?

  @@index([tenantId])
  @@index([tenantId, workflowId, startedAt])
  @@map("workflow_executions")
}

// ─────────────────────────────────────────────────────────────────────────
// Human handoff
// ─────────────────────────────────────────────────────────────────────────

enum HandoffReason {
  CUSTOMER_REQUEST
  LOW_CONFIDENCE
  UNSUPPORTED_REQUEST
  SENSITIVE_REQUEST
  REPEATED_FAILURE
}

enum HandoffStatus {
  PENDING
  ACTIVE
  RESOLVED
}

model HumanHandoff {
  id             String        @id @default(cuid())
  tenantId       String
  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversationId String
  conversation   Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  reason         HandoffReason
  status         HandoffStatus @default(PENDING)
  assignedUserId String?
  assignedUser   User?         @relation("AssignedAgent", fields: [assignedUserId], references: [id])
  notes          String?
  requestedAt    DateTime      @default(now())
  resolvedAt     DateTime?

  synthesizedInvariant SynthesizedInvariant?

  @@index([tenantId])
  @@index([tenantId, status])
  @@map("human_handoffs")
}

// ─────────────────────────────────────────────────────────────────────────
// Notifications, events, audit log
// ─────────────────────────────────────────────────────────────────────────

model Notification {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  type      String
  title     String
  body      String
  isRead    Boolean  @default(false)
  metadata  Json     @default("{}")
  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([tenantId, userId, isRead])
  @@map("notifications")
}

/// Internal event bus log — every emitted event (message.received, action.executed, ...)
/// is persisted here and can fan out to n8n workflows / webhooks / BullMQ jobs.
model Event {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  type          String
  payload       Json     @default("{}")
  sourceService String?
  createdAt     DateTime @default(now())

  workflowExecutions WorkflowExecution[]

  @@index([tenantId])
  @@index([tenantId, type, createdAt])
  @@map("events")
}

model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String
  entityType String
  entityId   String
  changes    Json     @default("{}")
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([tenantId])
  @@index([tenantId, entityType, entityId])
  @@map("audit_logs")
}

/// Platform-level (cross-tenant) admin actions — deliberately NOT tenant-scoped,
/// unlike AuditLog: these record what a SUPER_ADMIN did in the /admin console
/// (suspending a tenant, granting platform access, disabling an account), and
/// must survive the target tenant being deleted. Written by AdminService only.
model PlatformAuditLog {
  id          String   @id @default(cuid())
  actorUserId String
  actor       User     @relation("PlatformAuditActor", fields: [actorUserId], references: [id])
  action      String
  targetType  String // "tenant" | "user"
  targetId    String
  changes     Json     @default("{}")
  ipAddress   String?
  createdAt   DateTime @default(now())

  @@index([targetType, targetId])
  @@index([createdAt])
  @@map("platform_audit_logs")
}

// ─────────────────────────────────────────────────────────────────────────
// TEO-PIPS: Transactional Epistemic Orchestration & Policy Synthesis
// ─────────────────────────────────────────────────────────────────────────

enum ReversibilityType {
  QUERY
  COMPENSATABLE
  TERMINAL_IRREVERSIBLE
}

enum SagaStatus {
  ACTIVE
  COMMITTED
  COMPENSATED
  FAILED
}

model DynamicSaga {
  id             String       @id @default(cuid())
  tenantId       String
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  status         SagaStatus   @default(ACTIVE)
  failureReason  String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  steps SagaStep[]

  @@index([tenantId])
  @@index([tenantId, conversationId])
  @@map("dynamic_sagas")
}

model SagaStep {
  id                 String            @id @default(cuid())
  sagaId             String
  saga               DynamicSaga       @relation(fields: [sagaId], references: [id], onDelete: Cascade)
  actionName         String
  reversibility      ReversibilityType @default(COMPENSATABLE)
  inputPayload       Json              @default("{}")
  outputPayload      Json?
  compensatingAction String?
  isCompensated      Boolean           @default(false)
  compensatedAt      DateTime?
  error              String?
  executedAt         DateTime          @default(now())

  @@index([sagaId])
  @@map("saga_steps")
}

enum InvariantStatus {
  CANDIDATE
  SHADOW_VERIFIED
  ACTIVE
  REJECTED
  DEPRECATED
}

model SynthesizedInvariant {
  id                 String          @id @default(cuid())
  tenantId           String
  tenant             Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sourceHandoffId    String          @unique
  sourceHandoff      HumanHandoff    @relation(fields: [sourceHandoffId], references: [id], onDelete: Cascade)
  name               String
  description        String
  conditionRule      Json // Structured predicate JSON logic
  actionOverride     Json? // Structured action / routing override
  confidenceScore    Float           @default(0.0)
  regressionPassRate Float?
  status             InvariantStatus @default(CANDIDATE)
  activatedAt        DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@index([tenantId])
  @@index([tenantId, status])
  @@map("synthesized_invariants")
}

// ─────────────────────────────────────────────────────────────────────────
// Reply engine: answers that don't need an AI provider
// ─────────────────────────────────────────────────────────────────────────

/// AI: every reply is written by AI (original behaviour).
/// HYBRID: saved answers and fixed replies first; AI only when nothing matches.
/// NO_AI: never calls an AI provider; unmatched questions go to staff.
enum ReplyMode {
  AI
  HYBRID
  NO_AI
}

enum SavedAnswerStatus {
  /// Used to answer customers.
  ACTIVE
  /// A question customers asked that nothing answered; waiting for the owner.
  SUGGESTED
  /// Kept but not used.
  DISABLED
}

/// An owner-approved reply, matched against customer messages without AI.
model SavedAnswer {
  id                   String            @id @default(cuid())
  tenantId             String
  tenant               Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  status               SavedAnswerStatus @default(ACTIVE)
  /// Ways customers ask this, in any language (English, Sinhala, Singlish).
  questions            String[]
  answerEn             String            @default("")
  answerSi             String            @default("")
  answerSiLatn         String            @default("")
  /// SUGGESTED rows: how many times customers asked without getting an answer.
  askedCount           Int               @default(0)
  useCount             Int               @default(0)
  lastUsedAt           DateTime?
  sourceConversationId String?
  createdByUserId      String?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  @@index([tenantId, status])
  @@map("saved_answers")
}

/// Platform-admin settings per subscription plan (Tenant.plan).
model PlanSettings {
  planId            String      @id
  /// Reply modes businesses on this plan may choose. Empty = all modes.
  allowedReplyModes ReplyMode[]
  updatedAt         DateTime    @updatedAt

  @@map("plan_settings")
}
